{
  "name": "teraboxvd",
  "version": "1.0.0",
  "description": "TeraBoxVD — paste a TeraBox share link, browse it, stream it, download it. Self-hosted, zero runtime dependencies.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "token": "node tools/terabox-token.js",
    "bot": "node bot/telegram-bot.js",
    "selftest": "node tools/selftest.js",
    "test": "node tools/selftest.js"
  },
  "keywords": [
    "terabox",
    "download",
    "stream",
    "hls",
    "m3u8"
  ],
  "license": "MIT"
}
