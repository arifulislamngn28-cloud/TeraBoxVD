{
  "expo": {
    "name": "TeraBoxVD",
    "slug": "teraboxvd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "teraboxvd",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "android": {
      "package": "site.teraboxvd.player",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "https", "host": "terabox.com" },
            { "scheme": "https", "host": "www.terabox.com" },
            { "scheme": "https", "host": "1024terabox.com" },
            { "scheme": "https", "host": "terabox.app" },
            { "scheme": "https", "host": "4funbox.co" },
            { "scheme": "https", "host": "nephobox.com" }
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "site.teraboxvd.player",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TeraBoxVD to save videos and photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "apiBase": null
    }
  }
}
